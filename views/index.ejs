<%- include('partials/header') %>

<div class="container">
  <h1>🔗 URL Shortener</h1>

  <div class="card">
    <form action="/" method="POST">
      <input 
        type="url" 
        name="fullUrl" 
        placeholder="Enter long URL" 
        required 
      />
      <button type="submit">Shorten</button>
    </form>
  </div>

  <% if (urls && urls.length > 0) { %>
    <div class="table-container">
      <table>
        <tr>
          <th>Full URL</th>
          <th>Short URL</th>
        </tr>

        <% urls.forEach(url => { %>
          <tr>
            <td><%= url.full %></td>
            <td>
              <a href="/<%= url.short %>" class="short-link" target="_blank">
                <%= url.short %>
              </a>
            </td>
          </tr>
        <% }) %>

      </table>
    </div>
  <% } %>



</div>

<%- include('partials/footer') %>